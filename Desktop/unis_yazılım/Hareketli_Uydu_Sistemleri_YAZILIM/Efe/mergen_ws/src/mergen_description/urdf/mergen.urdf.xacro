<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mergen">
  <xacro:property name="pi" value="3.141592653589793" />

  <link name="base_link">
    <visual><geometry><cylinder radius="0.15" length="0.04"/></geometry></visual>
    <collision><geometry><cylinder radius="0.15" length="0.04"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="azimuth_platform">
    <visual><geometry><cylinder radius="0.13" length="0.03"/></geometry></visual>
    <collision><geometry><cylinder radius="0.13" length="0.03"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.015" iyy="0.015" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="azimuth_joint" type="continuous">
    <parent link="base_link"/>
    <child link="azimuth_platform"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="elevation_arm">
    <visual><geometry><box size="0.05 0.26 0.04"/></geometry></visual>
    <collision><geometry><box size="0.05 0.26 0.04"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="elevation_joint" type="revolute">
    <parent link="azimuth_platform"/>
    <child link="elevation_arm"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="${pi / 2}" effort="30" velocity="1.0"/>
  </joint>

  <link name="antenna_dish">
    <visual><origin xyz="0.12 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.15" length="0.02"/></geometry></visual>
    <collision><origin xyz="0.12 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.15" length="0.02"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.006" iyy="0.006" izz="0.006" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="dish_fixed_joint" type="fixed">
    <parent link="elevation_arm"/>
    <child link="antenna_dish"/>
    <origin xyz="0.08 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_fixed_joint" type="fixed">
    <parent link="azimuth_platform"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
